{
  "name": "nearpay-merchant-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo merchant backend: creates checkout sessions, receives signed webhooks, sells GET /premium behind the x402 paywall.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nearpay/node": "0.1.0",
    "@nearpay/spec": "0.1.4",
    "@nearpay/x402": "0.1.1",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@nearpay/spec": "0.1.4"
    }
  }
}
